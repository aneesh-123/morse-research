# ---- Required -------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, Render, RDS, local...). Use sslmode=require for hosted databases.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Public HTTPS address of the site, used in emailed sign-in links.
APP_URL=https://your-study.example.org

# ---- Consent contact details (required before participants can consent in production) ----
# These can also be edited later in the researcher dashboard (Study configuration).
STUDY_CONTACT_NAME=
STUDY_CONTACT_EMAIL=
# Optional. Leave empty unless true.
STUDY_INSTITUTION=
# Optional. Only fill in if an ethics approval actually exists, e.g. "Approved by X, ref 123".
STUDY_ETHICS_STATEMENT=
# Optional override of the default retention statement.
# STUDY_DATA_RETENTION=Research data is kept until the end of the research project and is then deleted or fully anonymised.

# ---- Email sign-in (optional; without it participants use recovery codes) ----
# Any SMTP provider, e.g. smtps://resend:API_KEY@smtp.resend.com:465
SMTP_URL=
EMAIL_FROM="Morse Study <study@your-domain.example>"

# ---- Optional ---------------------------------------------------------------
# DATABASE_POOL_MAX=5
# NEXT_OUTPUT=standalone   # set when building the Docker image
# Never set these in production:
# INSECURE_COOKIES=1       # allows cookies over plain http (local production test only)
# EMAIL_DEV_LOG=1          # prints sign-in emails to the server log instead of sending
# RATE_LIMIT_DISABLED=1    # tests only
